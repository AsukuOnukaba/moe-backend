PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080, http://127.0.0.1:8080, https://moe-africa-mvp.vercel.app
DATABASE_URL="postgresql://postgres:as562003@localhost:5432/moe_dev?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudinary — required for image uploads in production
# Sign up at https://cloudinary.com, copy from Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth — optional, needed for "Sign in with Google"
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:8080/auth/google/callback

# Resend SMTP — email verification OTP, admin 2FA, approval notifications
# 1. Sign up at https://resend.com
# 2. Create an API key (API Keys → Create API Key) and paste below as SMTP_PASS
# 3. Add + verify your sending domain (Domains → Add Domain) and set SMTP_FROM
# For local testing only: use SMTP_FROM=onboarding@resend.dev and send to your Resend account email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM=MoE Marketplace <noreply@your-verified-domain.com>