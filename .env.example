PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS, e.g.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Prisma (PostgreSQL for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moe_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudinary (required for image uploads in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:8080/auth/google/callback

# SMTP (optional — OTP emails log to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@moe-marketplace.com
