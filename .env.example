# Resend — server-side only. Never put RESEND_API_KEY in frontend or Vercel client env.
# Use the moe_sending key. Sender must be a verified domain.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="MOE Africa <verify@moe-africa.com>"
# Public site origin used in verification links.
# Local: http://localhost:8080  Production: https://moe-africa.com
# FRONTEND_URL=http://localhost:8080

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS, e.g.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Prisma (PostgreSQL for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moe_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="30d"

# Public base URL (legacy local /uploads links; new uploads use Cloudinary URLs)
BASE_URL=http://localhost:3000

# Cloudinary — image uploads (products, store, covers, avatars)
# Also required for private messaging attachments (authenticated Cloudinary assets).
# Dashboard → Account Details. API secret stays server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 1 order readiness — NGN threshold for detailed (high-value) assessments.
# Custom orders always use the detailed form. Default in code: 150000.
# ORDER_HIGH_VALUE_THRESHOLD_NGN=150000

# Phase 2 Batch 1B — initial artisan payout (manual verification; NOT a payment gateway).
# Comma-separated admin user IDs granted all payout finance capabilities (bootstrap).
# Prefer User.adminCapabilities in DB for production separation of recorder vs verifier.
# ADMIN_PAYOUT_FINANCE_USER_IDS=1
#
# Optional absolute/ratio limits per currency. Do NOT invent a default percentage.
# Example absolute-only: {"NGN":{"maxAbsolute":50000}}
# Example with approved ratio: {"NGN":{"maxAbsolute":100000,"maxRatio":0.4}}
# When unset, approving an amount requires exceptionApproved + exceptionReason.
# INITIAL_PAYOUT_LIMITS_JSON=

# Customer delivery review window (hours after delivered). Unset = no auto
# final-payout eligibility / escalation (safe until product approves a duration).
CUSTOMER_DELIVERY_REVIEW_HOURS=72

# Order schedulers (readiness, production deadlines, delivery review).
# Set ORDER_SCHEDULERS_ENABLED=false on non-leader app instances when running
# multiple Nest replicas so cron ticks do not race. Default: enabled.
ORDER_SCHEDULERS_ENABLED=true
APP_TIMEZONE=Africa/Lagos

# Google OAuth (server only — never put the client secret in the frontend).
# Both values must be set or /auth/google will not redirect to Google.
# Register each callback in Google Cloud as an authorized redirect URI.
#
# Working site (Vercel):
#   GOOGLE_CALLBACK_URL=https://moe-backend.duckdns.org/auth/google/callback
#   GOOGLE_SUCCESS_REDIRECT=https://moe-africa-mvp.vercel.app/auth/callback
# Production (moe-africa.com):
#   GOOGLE_CALLBACK_URL=https://api.moe-africa.com/auth/google/callback
#   GOOGLE_SUCCESS_REDIRECT=https://moe-africa.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://moe-backend.duckdns.org/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=https://moe-africa-mvp.vercel.app/auth/callback

# Allow DELETE /conversations (bulk wipe) in production when set to true.
# In non-production NODE_ENV, bulk delete is always allowed.
# ALLOW_CONVERSATION_BULK_DELETE=true

# Clerk — server-side verification for POST /auth/clerk-verify
CLERK_SECRET_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:8080

# Payments — server-side only. Never put these in the frontend or Vercel client env.
# Development stays in test mode. Live charges require BOTH:
#   PAYMENT_MODE=live
#   PAYMENT_LIVE_ENABLED=true
# and the matching live secret keys. Leave live disabled until explicitly approved.
PAYMENT_MODE=test
PAYMENT_LIVE_ENABLED=false
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Customer return origin for hosted checkout. Local: http://localhost:8080
# Working site: https://moe-africa-mvp.vercel.app
# FRONTEND_URL=http://localhost:8080
