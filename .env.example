# Resend — server-side only. Never put RESEND_API_KEY in frontend or Vercel client env.
# Use the moe_sending key. Sender must be a verified domain.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="MOE Africa <verify@moe-africa.com>"
# Public site origin used in verification links.
# Local: http://localhost:8080  Production: https://moe-africa.com
# FRONTEND_URL=http://localhost:8080

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS, e.g.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Prisma (PostgreSQL for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moe_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="30d"

# Public base URL (legacy local /uploads links; new uploads use Cloudinary URLs)
BASE_URL=http://localhost:3000

# Cloudinary — image uploads (products, store, covers, avatars)
# Dashboard → Account Details. API secret stays server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (server only — never put the client secret in the frontend).
# Both values must be set or /auth/google will not redirect to Google.
# Production callback must be the public API URL registered in Google Cloud:
#   GOOGLE_CALLBACK_URL=https://moe-backend.duckdns.org/auth/google/callback
#   GOOGLE_SUCCESS_REDIRECT=https://moe-africa-mvp.vercel.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:8080/auth/callback

# Allow DELETE /conversations (bulk wipe) in production when set to true.
# In non-production NODE_ENV, bulk delete is always allowed.
# ALLOW_CONVERSATION_BULK_DELETE=true

# Clerk — server-side verification for POST /auth/clerk-verify
CLERK_SECRET_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:8080
