generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int       @id @default(autoincrement())
  name                        String
  email                       String    @unique
  passwordHash                String
  phone                       String?
  avatarUrl                   String?
  googleId                    String?   @unique
  clerkId                     String?   @unique
  status                      String    @default("active")
  passwordResetTokenHash      String?
  passwordResetExpires        DateTime?
  /// Existing rows stay verified. Email/password registration sets this to false.
  emailVerified               Boolean   @default(true)
  emailVerificationTokenHash  String?   @unique
  emailVerificationExpires    DateTime?
  emailVerificationConsumedAt DateTime?
  emailVerificationSentAt     DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  /// Admin action capabilities (finance/payout). Empty = no finance actions.
  /// e.g. payout_amount_approve, payout_transfer_record, payout_transfer_verify, payout_dispute, payout_mark_not_required
  adminCapabilities           String[]  @default([])
  /// Dedicated local/staging fixture identity; never set on real users.
  isTestUser                  Boolean   @default(false)

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  addresses       Address[]
  wishlistItems   WishlistItem[]
  paymentMethods  PaymentMethod[]
  paymentAttempts PaymentAttempt[]
  preference      UserPreference?

  artisanProfile        ArtisanProfile?
  products              Product[]
  customerConversations Conversation[]       @relation("CustomerConversations")
  sentMessages          Message[]
  artisanReviews        ArtisanReview[]      @relation("CustomerReviews")
  productReviews        ProductReview[]
  notifications         Notification[]
  behaviourEvents       UserBehaviourEvent[]
  customerCustomOrders  CustomOrder[]        @relation("CustomerCustomOrders")
  supportTickets        ContactMessage[]     @relation("SupportTicketSubmitter")
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  addressLine1 String
  city         String
  state        String
  country      String
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethods PaymentMethod[]

  @@index([userId])
}

model ArtisanProfile {
  userId Int  @id @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName         String?
  businessName      String?
  firstName         String?
  lastName          String?
  about             String?
  description       String?
  country           String?
  address           String?
  city              String?
  state             String?
  location          String?
  category          String?
  styleTags         String?
  serviceCategories String[] @default([])
  heroImage         String?
  storeImageUrl     String?
  coverImageUrl     String?
  images            String[]

  status          String  @default("pending")
  rejectionReason String?

  customOrdersEnabled       Boolean   @default(false)
  isCustomOrderEligible     Boolean   @default(false)
  customOrderApprovedAt     DateTime?
  customOrderApprovedBy     String?
  rushOrderEnabled          Boolean   @default(false)
  rushOrderSurchargePercent Float     @default(25)
  verified                  Boolean   @default(false)
  featured                  Boolean   @default(false)

  estimatedDeliveryDays Int   @default(7)
  rating                Float @default(0)
  reviewCount           Int   @default(0)

  paymentSchedule        String?
  depositPercentage      Float?
  refundPolicy           String?
  acceptedPaymentMethods String[]
  installmentsAvailable  Boolean  @default(false)
  installmentDetails     String?

  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  xUrl         String?
  linkedinUrl  String?

  products        Product[]
  customOrders    CustomOrder[]
  reviews         ArtisanReview[]
  keywords        ArtisanKeyword[]
  score           ArtisanScore?
  customOrderRank CustomOrderRank?

  metaTitle       String?
  metaDescription String?

  providerConversations Conversation[]                @relation("ProviderConversations")
  verificationDocuments ArtisanVerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  userId    Int
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                    Int      @id @default(autoincrement())
  name                  String
  description           String?
  category              String?
  price                 Float?
  priceMin              Float?
  priceMax              Float?
  originalPrice         Float?
  currency              String   @default("NGN")
  imageUrl              String?
  images                String[]
  materials             String?
  tags                  String?
  status                String   @default("pending")
  rejectionReason       String?
  customisationRequired Boolean  @default(false)
  /// Structured storefront audiences. Existing products remain discoverable with an empty list.
  designedFor                  String[] @default([])
  audienceClassificationStatus String   @default("unclassified")
  audienceClassifiedAt          DateTime?
  audienceClassifiedById        Int?

  providerId Int?
  provider   User? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  artisanId Int?
  artisan   ArtisanProfile? @relation(fields: [artisanId], references: [userId], onDelete: Cascade)

  featured        Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isTrending      Boolean @default(false)
  isNewArrival    Boolean @default(false)
  discountPercent Float?

  estimatedDeliveryDays Int     @default(7)
  estimatedDelivery     String?

  metaTitle       String?
  metaDescription String?
  stockCount      Int?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlistItems  WishlistItem[]
  reviews        ProductReview[]
  keywords       ProductKeyword[]
  variationTypes ProductVariationType[]
  sizeProfiles   ProductSizeProfile[]

  @@index([providerId])
  @@index([artisanId])
  @@index([artisanId, status])
  @@index([category])
  @@index([audienceClassificationStatus])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  adminUserId Int?
  targetType  String
  targetId    Int
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model PaymentMethod {
  id               String   @id @default(uuid())
  userId           Int
  brand            String
  last4            String
  expiry           String
  expiryMonth      Int?
  expiryYear       Int?
  processorToken   String?
  cardholderName   String
  billingAddressId Int?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingAddress Address? @relation(fields: [billingAddressId], references: [id])

  @@index([userId])
  @@index([billingAddressId])
}

model Order {
  id                     Int     @id @default(autoincrement())
  customerId             Int
  productId              Int
  productName            String?
  productImage           String?
  providerId             Int?
  providerName           String?
  customizationId        Int?
  isCustomOrder          Boolean @default(false)
  status                 String  @default("pending")
  price                  Float?
  basePrice              Float?
  rushSurcharge          Float?
  rushOrder              Boolean @default(false)
  customisationData      Json?
  currency               String  @default("NGN")
  paymentMethod          String  @default("bank_transfer")
  paymentMethodId        String?
  paymentReference       String?
  paymentStatus          String  @default("unpaid")
  /// Simulation markers are immutable identifiers for isolated test orders.
  isTestOrder            Boolean @default(false)
  testReference          String? @unique
  simulatedPaymentStatus String?
  simulationTimeScenario String?

  shippingAddress      Json?
  shippingFirstName    String?
  shippingLastName     String?
  shippingPhone        String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingCountry      String?
  shippingPostalCode   String?

  estimatedDelivery String?

  /// Phase 1 readiness workflow (null = legacy order, not in mandatory readiness flow).
  readinessAssignedAt         DateTime?
  readinessResponseDeadline   DateTime?
  readinessDeadlineExtendedAt DateTime?
  readinessExtensionHours     Int?
  readinessExtensionReason    String?
  readinessExtensionById      Int?
  /// awaiting_response | overdue | submitted | under_review | changes_requested | approved | rejected | cannot_fulfil
  readinessWorkflowStatus     String?
  /// Admin/config override: force detailed assessment regardless of price.
  highValueOverride           Boolean?

  /// Phase 2: set exactly once when Start Work is authorised.
  productionStartedAt        DateTime?
  productionDeadline         DateTime?
  /// First deadline at Start Work — never overwritten by extensions.
  productionOriginalDeadline DateTime?
  productionStartedById      Int?
  /// Days used to compute productionDeadline (from approved readiness).
  productionDurationDays     Int?

  /// Phase 2+ quality review (separate from fulfillment & payments).
  /// null | in_production | submitted | changes_requested | approved | rejected
  qualityReviewStatus String?
  qualitySubmittedAt  DateTime?
  qualityApprovedAt   DateTime?
  qualityApprovedById Int?

  /// Fulfillment sub-status after quality approval (separate from customer/artisan payment).
  /// null | ready_for_delivery | dispatched | delivered | customer_accepted | delivery_disputed
  fulfillmentStatus         String?
  dispatchedAt              DateTime?
  deliveredAt               DateTime?
  customerAcceptedAt        DateTime?
  customerReviewDeadline    DateTime?
  customerRating            Int?
  customerReview            String?
  finalPayoutReviewEligible Boolean   @default(false)
  finalPayoutEscalatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory                OrderStatusHistory[]
  disputes                     Dispute[]
  paymentAttempts              PaymentAttempt[]
  readinessAssessments         OrderReadinessAssessment[]
  readinessReminders           OrderReadinessReminder[]
  readinessEvents              OrderReadinessEvent[]
  artisanPayout                OrderArtisanPayout?
  productionProgressUpdates    OrderProductionProgressUpdate[]
  productionDeadlineExtensions OrderProductionDeadlineExtension[]
  productionEvents             OrderProductionEvent[]
  productionReminders          OrderProductionReminder[]
  qualitySubmissions           OrderQualitySubmission[]
  deliveryEvents               OrderDeliveryEvent[]
  productReviews               ProductReview[]
  artisanReviews               ArtisanReview[]
  supportTickets               ContactMessage[]
  simulatedSettlement          SimulatedPaymentSettlement?

  @@index([customerId])
  @@index([productId])
  @@index([providerId])
  @@index([readinessWorkflowStatus])
  @@index([readinessResponseDeadline])
  @@index([productionStartedAt])
  @@index([productionDeadline])
  @@index([qualityReviewStatus])
  @@index([fulfillmentStatus])
  @@index([isTestOrder, createdAt])
}

/// Versioned artisan readiness assessment for an order.
model OrderReadinessAssessment {
  id                       Int       @id @default(autoincrement())
  orderId                  Int
  version                  Int
  /// standard | detailed
  type                     String
  /// draft | submitted | changes_requested | approved | rejected | superseded | cannot_fulfil
  status                   String    @default("draft")
  artisanId                Int
  payload                  Json
  cannotFulfil             Boolean   @default(false)
  cannotFulfilReason       String?
  acknowledgedRequirements Boolean   @default(false)
  reviewedRequirementsAt   DateTime?
  submittedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  evidence       OrderReadinessEvidence[]
  reviews        OrderReadinessReview[]
  artisanPayouts OrderArtisanPayout[]

  @@unique([orderId, version])
  @@index([orderId, status])
  @@index([artisanId])
}

model OrderReadinessEvidence {
  id                     Int      @id @default(autoincrement())
  assessmentId           Int
  /// Cloudinary public_id (authenticated) — never a public URL.
  attachmentPublicId     String
  attachmentResourceType String
  attachmentName         String
  attachmentMimeType     String
  attachmentBytes        Int?
  /// image | document | voice
  attachmentKind         String
  durationMs             Int?
  createdAt              DateTime @default(now())

  assessment OrderReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model OrderReadinessReview {
  id           Int      @id @default(autoincrement())
  assessmentId Int
  reviewerId   Int
  /// approve | request_changes | reject
  decision     String
  reason       String?
  createdAt    DateTime @default(now())

  assessment OrderReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([reviewerId])
}

/// Deduped deadline reminder / overdue escalation records.
model OrderReadinessReminder {
  id      Int      @id @default(autoincrement())
  orderId Int
  /// reminder_12h | reminder_20h | overdue
  kind    String
  sentAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([orderId])
}

/// Append-only audit trail for readiness workflow actions.
model OrderReadinessEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  actorId   Int?
  /// assigned | submitted | reminder | overdue | extended | approved | changes_requested | rejected | cannot_fulfil
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Phase 2 Batch 1B — artisan payout ledger (separate from customer PaymentAttempt).
model OrderArtisanPayout {
  id                            Int       @id @default(autoincrement())
  orderId                       Int       @unique
  assessmentId                  Int?
  currency                      String    @default("NGN")
  requestedAmount               Float?
  /// Initial material funding approved amount (Batch 1B).
  approvedAmount                Float?
  amountApprovedById            Int?
  amountApprovedAt              DateTime?
  amountApprovalReason          String?
  exceptionApproved             Boolean   @default(false)
  exceptionReason               String?
  /// configured | missing | exceeded_with_exception | not_applicable
  limitPolicyStatus             String?
  fundingRequired               Boolean   @default(true)
  /// requested | amount_approved | recorded | verified | rejected | disputed | reversed | not_required
  status                        String    @default("requested")
  isSimulated                   Boolean   @default(false)
  disputeFlag                   Boolean   @default(false)
  disputeNotes                  String?
  /// Total approved artisan payable across milestones (may equal sum of milestones).
  totalPayableAmount            Float?
  totalPayableApprovedById      Int?
  totalPayableApprovedAt        DateTime?
  totalPayableReason            String?
  totalPayableExceptionApproved Boolean   @default(false)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  order      Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assessment OrderReadinessAssessment?     @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  transfers  OrderArtisanPayoutTransfer[]
  events     OrderArtisanPayoutEvent[]
  milestones OrderArtisanPayoutMilestone[]

  @@index([status])
  @@index([assessmentId])
}

model OrderArtisanPayoutMilestone {
  id                 Int       @id @default(autoincrement())
  payoutId           Int
  /// initial | intermediate | final
  kind               String
  name               String
  description        String?
  sequence           Int       @default(0)
  approvedAmount     Float
  currency           String    @default("NGN")
  /// planned | eligible | amount_approved | recorded | verified | disputed | reversed | cancelled
  status             String    @default("planned")
  dueConditions      Json?
  amountApprovedById Int?
  amountApprovedAt   DateTime?
  eligibleAt         DateTime?
  exceptionApproved  Boolean   @default(false)
  exceptionReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payout    OrderArtisanPayout           @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transfers OrderArtisanPayoutTransfer[]

  @@index([payoutId, sequence])
  @@index([status])
}

model OrderArtisanPayoutTransfer {
  id                Int       @id @default(autoincrement())
  payoutId          Int
  milestoneId       Int?
  amount            Float
  currency          String
  transferDate      DateTime
  payeeName         String
  payeeDetails      String?
  /// Unique bank/transfer reference — prevents duplicate recording.
  externalReference String    @unique
  /// recorded | verified | rejected | disputed | reversed
  status            String    @default("recorded")
  recordedById      Int
  recordedAt        DateTime  @default(now())
  verifiedById      Int?
  verifiedAt        DateTime?
  verificationNotes String?
  rejectionReason   String?
  isSimulated       Boolean   @default(false)

  payout    OrderArtisanPayout           @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  milestone OrderArtisanPayoutMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  evidence  OrderArtisanPayoutEvidence[]

  @@index([payoutId, status])
  @@index([milestoneId])
  @@index([recordedById])
}

model OrderArtisanPayoutEvidence {
  id                     Int      @id @default(autoincrement())
  transferId             Int
  attachmentPublicId     String
  attachmentResourceType String
  attachmentName         String
  attachmentMimeType     String
  attachmentBytes        Int?
  attachmentKind         String
  createdAt              DateTime @default(now())

  transfer OrderArtisanPayoutTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model OrderArtisanPayoutEvent {
  id        Int      @id @default(autoincrement())
  payoutId  Int
  orderId   Int
  actorId   Int?
  /// amount_approved | funding_not_required | transfer_recorded | transfer_verified | transfer_rejected | disputed | reversed | start_work | milestone_*
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  payout OrderArtisanPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId, createdAt])
  @@index([orderId, createdAt])
}

/// Batch A — artisan production progress notes + evidence.
model OrderProductionProgressUpdate {
  id              Int      @id @default(autoincrement())
  orderId         Int
  artisanId       Int
  note            String
  percentComplete Int?
  createdAt       DateTime @default(now())

  order    Order                             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  evidence OrderProductionProgressEvidence[]

  @@index([orderId, createdAt])
  @@index([artisanId])
}

model OrderProductionProgressEvidence {
  id                     Int      @id @default(autoincrement())
  progressUpdateId       Int
  attachmentPublicId     String
  attachmentResourceType String
  attachmentName         String
  attachmentMimeType     String
  attachmentBytes        Int?
  /// image | document | voice
  attachmentKind         String
  durationMs             Int?
  createdAt              DateTime @default(now())

  progressUpdate OrderProductionProgressUpdate @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)

  @@index([progressUpdateId])
}

model OrderProductionDeadlineExtension {
  id               Int      @id @default(autoincrement())
  orderId          Int
  previousDeadline DateTime
  newDeadline      DateTime
  extraHours       Int
  reason           String
  extendedById     Int
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderProductionEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  actorId   Int?
  /// progress_submitted | deadline_extended | overdue | reminder
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderProductionReminder {
  id      Int      @id @default(autoincrement())
  orderId Int
  /// reminder_50 | overdue
  kind    String
  sentAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([orderId])
}

/// Batch B — quality submission for admin review.
model OrderQualitySubmission {
  id                Int      @id @default(autoincrement())
  orderId           Int
  version           Int
  artisanId         Int
  /// submitted | changes_requested | approved | rejected | superseded
  status            String   @default("submitted")
  description       String
  specsConfirmed    Boolean  @default(false)
  outstandingIssues String?
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order    Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  evidence OrderQualityEvidence[]
  reviews  OrderQualityReview[]

  @@unique([orderId, version])
  @@index([orderId, status])
}

model OrderQualityEvidence {
  id                     Int      @id @default(autoincrement())
  submissionId           Int
  attachmentPublicId     String
  attachmentResourceType String
  attachmentName         String
  attachmentMimeType     String
  attachmentBytes        Int?
  /// image | document | voice
  attachmentKind         String
  durationMs             Int?
  createdAt              DateTime @default(now())

  submission OrderQualitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model OrderQualityReview {
  id           Int      @id @default(autoincrement())
  submissionId Int
  reviewerId   Int
  /// approve | request_rework | reject | escalate_dispute
  decision     String
  reason       String?
  createdAt    DateTime @default(now())

  submission OrderQualitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
}

model OrderDeliveryEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  actorId   Int?
  /// ready_for_delivery | dispatched | delivered | customer_accepted | delivery_disputed | review_window_elapsed | final_payout_eligible | escalated
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// One row per gateway checkout. Amounts are copied from the order at
/// initialization and checked again before the order is marked paid.
model PaymentAttempt {
  id             String    @id @default(uuid())
  orderId        Int
  customerId     Int
  gateway        String
  reference      String    @unique
  amountMinor    Int
  currency       String
  status         String    @default("pending")
  isSimulated    Boolean   @default(false)
  paymentUrl     String?
  accessCode     String?
  saveCard       Boolean   @default(false)
  cardOnly       Boolean   @default(false)
  providerStatus String?
  failureReason  String?
  paidAt         DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orderId, gateway, status])
  @@index([customerId])
}

/// Test-only customer settlement. It deliberately has no gateway or provider
/// reference and is never processed by Paystack/Flutterwave code.
model SimulatedPaymentSettlement {
  id          String   @id @default(uuid())
  orderId     Int      @unique
  customerId  Int
  amountMinor Int
  currency    String
  status      String   @default("succeeded")
  createdById Int
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([createdById, createdAt])
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid())
  gateway   String
  eventKey  String
  reference String?
  createdAt DateTime @default(now())

  @@unique([gateway, eventKey])
}

model Dispute {
  id           String   @id @default(uuid())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  customerId   Int
  issueType    String
  description  String
  evidenceUrls String[] @default([])
  status       String   @default("open")
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedBy Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderId, createdAt])
}

model ContactMessage {
  id            Int      @id @default(autoincrement())
  senderName    String
  senderEmail   String
  message       String
  subject       String?
  createdAt     DateTime @default(now())
  isRead        Boolean  @default(false)
  source        String   @default("contact_us")
  submittedById Int?
  orderId       Int?
  category      String?
  status        String   @default("open")
  updatedAt     DateTime @updatedAt

  submittedBy User?                     @relation("SupportTicketSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  order       Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attachments SupportTicketAttachment[]
  events      SupportTicketEvent[]

  @@index([source, createdAt])
  @@index([isRead])
  @@index([submittedById, createdAt])
  @@index([orderId, createdAt])
  @@index([status])
}

model SupportTicketAttachment {
  id                     Int      @id @default(autoincrement())
  ticketId               Int
  attachmentPublicId     String
  attachmentResourceType String
  attachmentName         String
  attachmentMimeType     String
  attachmentBytes        Int?
  attachmentKind         String
  durationMs             Int?
  createdAt              DateTime @default(now())

  ticket ContactMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicketEvent {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  actorId   Int?
  status    String
  note      String?
  createdAt DateTime @default(now())

  ticket ContactMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model ArtisanVerificationDocument {
  id        Int            @id @default(autoincrement())
  artisanId Int
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  fileType  String
  fileUrl   String
  status    String         @default("pending")
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([artisanId])
}

model UserPreference {
  userId     Int      @id
  categories String[] @default([])
  styleTags  String[] @default([])
  budget     Float    @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id         Int      @id @default(autoincrement())
  productId  Int
  customerId Int
  /// When set, ties this review to a completed order (at most one per order).
  orderId    Int?     @unique
  rating     Int
  review     String?
  status     String   @default("approved")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([customerId, productId])
  @@index([productId])
  @@index([orderId])
}

model ArtisanReview {
  id         Int      @id @default(autoincrement())
  artisanId  Int
  customerId Int
  /// When set, ties this review to a completed order (at most one per order).
  orderId    Int?     @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  artisan  ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  customer User           @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([customerId, artisanId])
  @@index([artisanId])
  @@index([orderId])
}

model Conversation {
  id              Int       @id @default(autoincrement())
  customerId      Int
  providerId      Int
  lastMessage     String?
  lastMessageTime DateTime?
  artisanNote     String?
  status          String    @default("unread")
  /// Soft-delete / archive timestamp. Null = active in participant + admin lists.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer User           @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  provider ArtisanProfile @relation("ProviderConversations", fields: [providerId], references: [userId], onDelete: Cascade)
  messages Message[]

  @@unique([customerId, providerId])
  @@index([customerId])
  @@index([providerId])
  @@index([deletedAt])
}

model Message {
  id                     Int       @id @default(autoincrement())
  conversationId         Int
  senderId               Int
  senderType             String
  senderRole             String    @default("customer")
  content                String
  sentAt                 DateTime  @default(now())
  readAt                 DateTime?
  /// Cloudinary public_id for authenticated message attachments (never a public URL).
  attachmentPublicId     String?
  attachmentResourceType String?
  attachmentName         String?
  attachmentMimeType     String?
  attachmentBytes        Int?
  /// image | document | voice
  attachmentKind         String?
  /// Voice note duration in milliseconds (null for non-voice).
  durationMs             Int?
  /// Client idempotency key — prevents duplicate voice/attachment submits.
  clientKey              String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientKey])
  @@index([conversationId])
  @@index([senderId])
}

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int
  type           String
  title          String
  body           String
  read           Boolean  @default(false)
  link           String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  icon      String?
  isSeed    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Internal admin-only artisan performance score (never exposed on public APIs).
model ArtisanScore {
  id                  String         @id @default(uuid())
  artisanId           Int            @unique
  artisan             ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  orderCompletionRate Float          @default(0)
  avgResponseTimeHrs  Float?
  reviewQualityScore  Float          @default(0)
  activityScore       Float          @default(0)
  compositeScore      Float          @default(0)
  lastCalculatedAt    DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([compositeScore])
}

model CuratedSection {
  id         String        @id @default(uuid())
  sectionKey String        @unique
  label      String
  isActive   Boolean       @default(true)
  keywords   String[]      @default([])
  items      CuratedItem[]
  updatedAt  DateTime      @updatedAt
  updatedBy  String?

  @@index([isActive])
}

model CuratedItem {
  id        String         @id @default(uuid())
  sectionId String
  section   CuratedSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// "artisan" | "product"
  itemType  String
  /// Stringified Int id of Product or ArtisanProfile.userId
  itemId    String
  position  Int
  isActive  Boolean        @default(true)
  addedBy   String?
  addedAt   DateTime       @default(now())

  @@unique([sectionId, itemId])
  @@index([sectionId, position])
  @@index([sectionId, isActive])
}

model Keyword {
  id        String           @id @default(uuid())
  term      String           @unique
  products  ProductKeyword[]
  artisans  ArtisanKeyword[]
  createdAt DateTime         @default(now())
}

model ProductKeyword {
  productId Int
  keywordId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([productId, keywordId])
  @@index([keywordId])
}

model ArtisanKeyword {
  artisanId Int
  keywordId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  keyword   Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([artisanId, keywordId])
  @@index([keywordId])
}

model UserBehaviourEvent {
  id         String   @id @default(uuid())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String
  eventType  String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([entityId])
  @@index([entityId, eventType, createdAt])
  @@index([entityType, eventType, createdAt])
  @@index([sessionId, eventType, entityId, createdAt])
}

model ProductVariationType {
  id         String            @id @default(uuid())
  productId  Int
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  typeName   String
  isEnabled  Boolean           @default(true)
  isRequired Boolean           @default(false)
  options    VariationOption[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([productId, typeName])
  @@index([productId])
}

model VariationOption {
  id              String               @id @default(uuid())
  variationTypeId String
  variationType   ProductVariationType @relation(fields: [variationTypeId], references: [id], onDelete: Cascade)
  label           String
  value           String
  colorHex        String?
  priceOverride   Float?
  stockCount      Int?
  isAvailable     Boolean              @default(true)
  position        Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([variationTypeId])
}

/// Current structured size guide for one product audience. Historical checkout
/// selections are copied into Order.customisationData and never read back from here.
model ProductSizeProfile {
  id                     String   @id @default(uuid())
  productId              Int
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  audience               String
  productType            String
  sizingSystem           String
  unit                    String
  measurementDefinitions Json
  isMadeToMeasure        Boolean  @default(false)
  instructions           String?
  illustrationUrl        String?
  version                 Int      @default(1)
  sizes                   ProductSizeOption[]
  fitChoices              ProductFitChoice[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([productId, audience])
  @@index([productId])
}

model ProductSizeOption {
  id           String             @id @default(uuid())
  profileId    String
  profile      ProductSizeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label        String
  measurements Json
  position     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([profileId, label])
  @@index([profileId])
}

model ProductFitChoice {
  id              String             @id @default(uuid())
  profileId       String
  profile         ProductSizeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label           String
  description     String
  illustrationUrl String?
  position        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([profileId, label])
  @@index([profileId])
}

model CustomOrder {
  id                  String         @id @default(uuid())
  artisanId           Int
  artisan             ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  customerId          Int
  customer            User           @relation("CustomerCustomOrders", fields: [customerId], references: [id], onDelete: Cascade)
  description         String
  referenceImages     String[]       @default([])
  /// @deprecated Prefer budgetMin/budgetMax
  budget              Float?
  budgetMin           Float?
  budgetMax           Float?
  deadline            DateTime?
  specialInstructions String?
  /// Category-specific payload (tailoring measurements, shoe size, etc.)
  categoryFields      Json?
  status              String         @default("pending")
  artisanResponse     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([artisanId])
  @@index([customerId])
  @@index([status])
}

/// Custom-order discovery ranking (separate from ArtisanScore curation).
model CustomOrderRank {
  id                 String         @id @default(uuid())
  artisanId          Int            @unique
  artisan            ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  fulfilmentRate     Float          @default(0)
  satisfactionScore  Float          @default(0)
  avgResponseTimeHrs Float          @default(0)
  compositeRank      Float          @default(0)
  lastCalculatedAt   DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([compositeRank])
}
