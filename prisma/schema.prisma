generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  addressLine1 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]

  artisanProfile ArtisanProfile?
  products       Product[]
}

model ArtisanProfile {
  userId Int  @id @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName         String?
  businessName      String?
  firstName         String?
  lastName          String?
  about             String?
  description       String?
  city              String?
  state             String?
  location          String?
  category          String?
  styleTags         String?
  serviceCategories String?
  heroImage         String?
  images            String[]

  customOrdersEnabled Boolean @default(false)
  verified            Boolean @default(false)
  featured            Boolean @default(false)

  estimatedDeliveryDays Int   @default(7)
  rating                Float @default(0)
  reviewCount           Int   @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  userId    Int
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  category      String?
  price         Float?
  priceMin      Float?
  priceMax      Float?
  originalPrice Float?
  currency      String   @default("NGN")
  imageUrl      String?
  images        String[]
  materials     String?
  tags          String?
  status        String   @default("ACTIVE")

  providerId Int?
  provider   User? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  artisanId Int?
  artisan   ArtisanProfile? @relation(fields: [artisanId], references: [userId], onDelete: Cascade)

  featured        Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isTrending      Boolean @default(false)
  isNewArrival    Boolean @default(false)
  discountPercent Float?

  estimatedDeliveryDays Int @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([artisanId])
  @@index([category])
}
