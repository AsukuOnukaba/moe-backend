generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int       @id @default(autoincrement())
  name                      String
  email                     String    @unique
  passwordHash              String
  phone                     String?
  avatarUrl                 String?
  googleId                  String?   @unique
  clerkId                   String?   @unique
  status                    String    @default("active")
  passwordResetTokenHash    String?
  passwordResetExpires      DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  addresses      Address[]
  wishlistItems  WishlistItem[]
  paymentMethods PaymentMethod[]
  preference     UserPreference?

  artisanProfile        ArtisanProfile?
  products              Product[]
  customerConversations Conversation[]  @relation("CustomerConversations")
  sentMessages          Message[]
  artisanReviews        ArtisanReview[] @relation("CustomerReviews")
  productReviews        ProductReview[]
  notifications         Notification[]
  behaviourEvents       UserBehaviourEvent[]
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  addressLine1 String
  city         String
  state        String
  country      String
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethods PaymentMethod[]

  @@index([userId])
}

model ArtisanProfile {
  userId Int  @id @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName         String?
  businessName      String?
  firstName         String?
  lastName          String?
  about             String?
  description       String?
  country           String?
  address           String?
  city              String?
  state             String?
  location          String?
  category          String?
  styleTags         String?
  serviceCategories String[] @default([])
  heroImage         String?
  storeImageUrl     String?
  coverImageUrl     String?
  images            String[]

  status          String  @default("pending")
  rejectionReason String?

  customOrdersEnabled       Boolean @default(false)
  rushOrderEnabled          Boolean @default(false)
  rushOrderSurchargePercent Float   @default(25)
  verified                  Boolean @default(false)
  featured                  Boolean @default(false)

  estimatedDeliveryDays Int   @default(7)
  rating                Float @default(0)
  reviewCount           Int   @default(0)

  paymentSchedule        String?
  depositPercentage      Float?
  refundPolicy           String?
  acceptedPaymentMethods String[]
  installmentsAvailable  Boolean  @default(false)
  installmentDetails     String?

  products Product[]
  reviews  ArtisanReview[]
  keywords ArtisanKeyword[]
  score    ArtisanScore?

  metaTitle       String?
  metaDescription String?

  providerConversations Conversation[] @relation("ProviderConversations")
  verificationDocuments ArtisanVerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  jti       String    @unique
  userId    Int
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                    Int      @id @default(autoincrement())
  name                  String
  description           String?
  category              String?
  price                 Float?
  priceMin              Float?
  priceMax              Float?
  originalPrice         Float?
  currency              String   @default("NGN")
  imageUrl              String?
  images                String[]
  materials             String?
  tags                  String?
  status                String   @default("pending")
  rejectionReason       String?
  customisationRequired Boolean  @default(false)

  providerId Int?
  provider   User? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  artisanId Int?
  artisan   ArtisanProfile? @relation(fields: [artisanId], references: [userId], onDelete: Cascade)

  featured        Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isTrending      Boolean @default(false)
  isNewArrival    Boolean @default(false)
  discountPercent Float?

  estimatedDeliveryDays Int     @default(7)
  estimatedDelivery     String?

  metaTitle       String?
  metaDescription String?
  stockCount      Int?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlistItems WishlistItem[]
  reviews       ProductReview[]
  keywords      ProductKeyword[]

  @@index([providerId])
  @@index([artisanId])
  @@index([category])
  @@index([status])
  @@index([deletedAt])
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  adminUserId Int?
  targetType  String
  targetId    Int
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model PaymentMethod {
  id               String   @id @default(uuid())
  userId           Int
  brand            String
  last4            String
  expiry           String
  expiryMonth      Int?
  expiryYear       Int?
  processorToken   String?
  cardholderName   String
  billingAddressId Int?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingAddress Address? @relation(fields: [billingAddressId], references: [id])

  @@index([userId])
  @@index([billingAddressId])
}

model Order {
  id                   Int     @id @default(autoincrement())
  customerId           Int
  productId            Int
  productName          String?
  productImage         String?
  providerId           Int?
  providerName         String?
  customizationId      Int?
  isCustomOrder        Boolean @default(false)
  status               String  @default("pending")
  price                Float?
  basePrice            Float?
  rushSurcharge        Float?
  rushOrder            Boolean @default(false)
  customisationData    Json?
  currency             String  @default("NGN")
  paymentMethod        String  @default("bank_transfer")
  paymentMethodId      String?
  paymentReference     String?
  paymentStatus        String  @default("unpaid")

  shippingAddress      Json?
  shippingFirstName    String?
  shippingLastName     String?
  shippingPhone        String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingCountry      String?
  shippingPostalCode   String?

  estimatedDelivery String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory OrderStatusHistory[]
  disputes      Dispute[]

  @@index([customerId])
  @@index([productId])
  @@index([providerId])
}

model Dispute {
  id           String   @id @default(uuid())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  customerId   Int
  issueType    String
  description  String
  evidenceUrls String[] @default([])
  status       String   @default("open")
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedBy Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderId, createdAt])
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  senderName  String
  senderEmail String
  message     String
  subject     String?
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)
  source      String   @default("contact_us")

  @@index([source, createdAt])
  @@index([isRead])
}

model ArtisanVerificationDocument {
  id        Int      @id @default(autoincrement())
  artisanId Int
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  fileType  String
  fileUrl   String
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanId])
}

model UserPreference {
  userId      Int      @id
  categories  String[] @default([])
  styleTags   String[] @default([])
  budget      Float    @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id         Int      @id @default(autoincrement())
  productId  Int
  customerId Int
  rating     Int
  review     String?
  status     String   @default("approved")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
}

model ArtisanReview {
  id         Int      @id @default(autoincrement())
  artisanId  Int
  customerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  artisan  ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  customer User           @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, artisanId])
  @@index([artisanId])
}

model Conversation {
  id              Int       @id @default(autoincrement())
  customerId      Int
  providerId      Int
  lastMessage     String?
  lastMessageTime DateTime?
  artisanNote     String?
  status          String    @default("unread")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer User           @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  provider ArtisanProfile @relation("ProviderConversations", fields: [providerId], references: [userId], onDelete: Cascade)
  messages Message[]

  @@unique([customerId, providerId])
  @@index([customerId])
  @@index([providerId])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  senderType     String
  senderRole     String    @default("customer")
  content        String
  sentAt         DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int
  type           String
  title          String
  body           String
  read           Boolean  @default(false)
  link           String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  icon      String?
  isSeed    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Internal admin-only artisan performance score (never exposed on public APIs).
model ArtisanScore {
  id                  String   @id @default(uuid())
  artisanId           Int      @unique
  artisan             ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  orderCompletionRate Float    @default(0)
  avgResponseTimeHrs  Float?
  reviewQualityScore  Float    @default(0)
  activityScore       Float    @default(0)
  compositeScore      Float    @default(0)
  lastCalculatedAt    DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([compositeScore])
}

model CuratedSection {
  id         String        @id @default(uuid())
  sectionKey String        @unique
  label      String
  isActive   Boolean       @default(true)
  keywords   String[]      @default([])
  items      CuratedItem[]
  updatedAt  DateTime      @updatedAt
  updatedBy  String?

  @@index([isActive])
}

model CuratedItem {
  id        String         @id @default(uuid())
  sectionId String
  section   CuratedSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// "artisan" | "product"
  itemType  String
  /// Stringified Int id of Product or ArtisanProfile.userId
  itemId    String
  position  Int
  isActive  Boolean        @default(true)
  addedBy   String?
  addedAt   DateTime       @default(now())

  @@unique([sectionId, itemId])
  @@index([sectionId, position])
  @@index([sectionId, isActive])
}

model Keyword {
  id        String           @id @default(uuid())
  term      String           @unique
  products  ProductKeyword[]
  artisans  ArtisanKeyword[]
  createdAt DateTime         @default(now())
}

model ProductKeyword {
  productId Int
  keywordId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([productId, keywordId])
  @@index([keywordId])
}

model ArtisanKeyword {
  artisanId Int
  keywordId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [userId], onDelete: Cascade)
  keyword   Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([artisanId, keywordId])
  @@index([keywordId])
}

model UserBehaviourEvent {
  id         String   @id @default(uuid())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String
  eventType  String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([entityId])
  @@index([entityType, eventType, createdAt])
  @@index([sessionId, eventType, entityId, createdAt])
}
